{
  "name": "anna-whatsapp",
  "version": "1.0.0",
  "private": true,
  "description": "Anna — Agente WhatsApp de Colsubsidio (conector thin vía API REST)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "start:bot": "tsx scripts/start-bot.ts",
    "start:all": "concurrently --kill-others --names BOT,WEB --prefix-colors yellow,cyan \"pnpm run start:bot\" \"pnpm dev\"",
    "prod:all": "concurrently --kill-others --names BOT,WEB --prefix-colors yellow,cyan \"pnpm run start:bot\" \"pnpm start\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "next": "^15.2.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
